{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:allow-save",
    "fs:allow-write-text-file",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://github.com/crewshin/DiffChecker" }]
    }
  ]
}
